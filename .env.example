POSTGRES_USER=smartsupply
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smartsupply
POSTGRES_PORT=15432

PREFECT_PORT=14200
PREFECT_API_URL=http://127.0.0.1:14200/api

# MLflow (suivi des entraînements) : http://127.0.0.1:15000
MLFLOW_PORT=15000

# Prometheus (http://127.0.0.1:19090) et sa boîte de dépôt pour le cycle
PROMETHEUS_PORT=19090
PUSHGATEWAY_PORT=19091

# Alertes envoyées PAR E-MAIL (Alertmanager)
# Gmail : compte Google > Sécurité > Validation en deux étapes (activée) > Mots de passe
# des applications > créer « SmartSupply » > copier les 16 lettres (sans les espaces).
ALERTMANAGER_PORT=19093
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=ton.adresse@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
ALERT_EMAIL_TO=ton.adresse@gmail.com

# Grafana : http://127.0.0.1:19300 (utilisateur admin)
GRAFANA_PORT=19300
GRAFANA_ADMIN_PASSWORD=change_me
# Mot de passe du compte lecture seule grafana_reader (database/roles_grafana.sql)
GRAFANA_DB_PASSWORD=change_me

# API de prévision : http://127.0.0.1:18800/docs
API_PORT=18800

# Site public (Streamlit) : publication nocturne des résultats sur la branche donnees-publiques.
# Jeton GitHub « fine-grained » : Repository access = ce dépôt seulement ; Permissions > Contents = Read and write.
# Laisser vide pour ne rien publier.
GITHUB_REPO=utilisateur/smartsupply-ai
GITHUB_TOKEN=

# Grafana Cloud (gratuit) : copie des chiffres Prometheus pour le tableau de bord public.
# Grafana Cloud > ta stack > Prometheus > Details : « Remote Write Endpoint » et « Username / Instance ID ».
# Jeton : Access Policies > nouveau jeton avec le droit metrics:write. Laisser vide pour ne rien envoyer.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_TOKEN=

# MLflow public sur DagsHub (gratuit) : copie des entraînements, du registre et de la surveillance.
# Dépôt DagsHub relié au dépôt GitHub ; jeton : DagsHub > Your Settings > Tokens. Laisser vide pour ne rien envoyer.
DAGSHUB_REPO=Elie224/smartsupply
DAGSHUB_USER=
DAGSHUB_TOKEN=

# Sauvegarde automatique (service backup) : tous les N jours, K gardées par base, dans ./backups
BACKUP_EVERY_DAYS=7
BACKUP_KEEP=8
