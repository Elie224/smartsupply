{
  "uid": "ss-cycle",
  "title": "SmartSupply — Cycle automatique",
  "description": "Le cycle tourne-t-il bien ? Réussites, échecs, durées, alertes.",
  "tags": [
    "smartsupply"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "État du cycle",
      "description": "Même règle que la carte Power BI et l'alerte Windows.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartsupply-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartsupply-pg"
          },
          "rawSql": "SELECT health_status FROM analytics.v_pipeline_health",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "ok": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "en retard": {
                  "text": "EN RETARD",
                  "color": "orange",
                  "index": 1
                },
                "échec": {
                  "text": "ÉCHEC",
                  "color": "red",
                  "index": 2
                },
                "aucun passage": {
                  "text": "AUCUN PASSAGE",
                  "color": "orange",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Dernière réussite il y a",
      "description": "Rouge au-delà de 26 h (alerte CycleEnRetard).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - smartsupply_pipeline_last_success_timestamp_seconds",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 93600,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Dernier passage",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "smartsupply_pipeline_last_run_success",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Réussi",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Échec",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Données jusqu'au",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartsupply-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartsupply-pg"
          },
          "rawSql": "SELECT to_char(last_simulated_day, 'DD/MM/YYYY') AS jour FROM analytics.v_pipeline_health",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 4
    },
    {
      "type": "table",
      "title": "Alertes en cours",
      "description": "Règles dans docker/prometheus/alerts.yml ; envoyées par e-mail par Alertmanager.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alertname"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Alerte"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Gravité"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "job"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Service"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 5
    },
    {
      "type": "row",
      "title": "Durées",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Durée de chaque étape",
      "description": "Mesurée à chaque passage (2 h 30 + rattrapages toutes les 3 h).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "smartsupply_pipeline_step_duration_seconds",
          "legendFormat": "{{step}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "auto",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Durée totale des passages",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartsupply-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartsupply-pg"
          },
          "rawSql": "SELECT finished_at AS time, duration_s AS \"Durée (s)\"\n                           FROM analytics.v_pipeline_runs WHERE $__timeFilter(finished_at)\n                           ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "lineWidth": 2,
            "fillOpacity": 80,
            "pointSize": 6,
            "showPoints": "auto",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8
    },
    {
      "type": "row",
      "title": "Journal",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Derniers passages",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartsupply-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartsupply-pg"
          },
          "rawSql": "SELECT finished_at AS \"Fin\", status AS \"Résultat\", duration_s AS \"Durée (s)\",\n                             days_added AS \"Journées ajoutées\", model_status AS \"Modèle\",\n                             forecast_status AS \"Prévision\", message AS \"Détail\"\n                      FROM analytics.v_pipeline_runs ORDER BY finished_at DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Résultat"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "text": "ok",
                        "color": "green",
                        "index": 0
                      },
                      "échec": {
                        "text": "échec",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 10
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Autres tableaux SmartSupply",
      "type": "dashboards",
      "tags": [
        "smartsupply"
      ],
      "asDropdown": true
    }
  ]
}
