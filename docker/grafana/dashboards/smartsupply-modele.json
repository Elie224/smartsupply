    {
      "type": "timeseries",
      "title": "Erreur réelle des prévisions vs erreur à l'entraînement",
      "description": "Zone rouge : au-delà de 18 % (alerte ErreurReelleElevee, en moyenne sur 4 semaines).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartsupply-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartsupply-pg"
          },
          "rawSql": "SELECT as_of_date::timestamp AS time, real_wape AS \"Erreur réelle (par jour de prévision)\"\n                   FROM analytics.v_monitoring_daily WHERE real_wape IS NOT NULL ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartsupply-pg"
          },
          "rawSql": "SELECT trained_at AS time, wape_pct / 100.0 AS \"Erreur à l'entraînement\",\n                          baseline_wape_pct / 100.0 AS \"Méthode naïve\"\n                   FROM analytics.v_model_runs ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "auto",
