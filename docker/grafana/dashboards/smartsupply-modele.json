    {
      "type": "table",
      "title": "Entraînements (retenus et refusés)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartsupply-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartsupply-pg"
          },
          "rawSql": "SELECT trained_at AS \"Date\", run_id AS \"Entraînement\", wape_pct AS \"WAPE %\",\n                             baseline_wape_pct AS \"Naïve %\", bias_pct AS \"Biais %\",\n                             CASE WHEN promoted THEN 'retenu' ELSE 'refusé' END AS \"Décision\",\n                             decision AS \"Raison\", is_current AS \"En service\"\n                      FROM analytics.v_model_runs ORDER BY trained_at DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Décision"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "retenu": {
                        "text": "retenu",
                        "color": "green",
                        "index": 0
                      },
                      "refusé": {
                        "text": "refusé",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
